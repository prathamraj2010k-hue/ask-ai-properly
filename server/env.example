# ============================================================
# AskAIProperly - Server Environment Configuration
# ============================================================
# Copy this file to `.env` and fill in your values:
#   cp .env.example .env
#
# NEVER commit your real .env file to version control,
# and NEVER put your API key in the frontend code.
# ============================================================

# ---- Which AI provider to use: "gemini" or "openai" ----
AI_PROVIDER=gemini

# ---- Your AI API key (REQUIRED for AI features) ----
# Gemini: get one free at https://aistudio.google.com/apikey
# OpenAI: get one at https://platform.openai.com/api-keys
# Leave as your_key_here to run in DEMO MODE (Learn, Lab and
# Templates still work; AI tabs show a friendly notice).
AI_API_KEY=your_key_here

# ---- Model names ----
# Gemini examples: gemini-1.5-flash (fast, free tier) / gemini-1.5-pro
# OpenAI examples: gpt-4o-mini (cheap) / gpt-4o
GEMINI_MODEL=gemini-1.5-flash
OPENAI_MODEL=gpt-4o-mini

# ---- Server config ----
PORT=5000
# Comma-separated list of allowed frontend origins.
CLIENT_ORIGIN=http://localhost:5173,https://askaimproperly.app,https://www.askaimproperly.app

# ---- Rate limiting (requests allowed per window) ----
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=60
